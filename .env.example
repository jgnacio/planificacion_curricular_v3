# Entorno: dev = LM Studio local | prod = Groq
APP_ENV=dev

# LM Studio (usado cuando APP_ENV=dev)
LMSTUDIO_API_BASE=http://localhost:1234/v1
LMSTUDIO_MAIN_MODEL_ID=local-model
OPENAI_API_KEY=lm-studio

# Groq (usado cuando APP_ENV=prod)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend (Next.js / facilitador_docente) ──────────────────────────────────
# Python REST API (planificaciones, alumnos)
API_URL=http://localhost:8001

# Google ADK agent (asistente docente)
ADK_URL=http://localhost:8000
